{
  "manifest_version": 3,
  "name": "JM Download Manager",
  "version": "1.0.0",
  "description": "Sends downloads and videos to the JM Download Manager app for fast multi-connection downloading.",
  "permissions": ["downloads", "contextMenus", "cookies", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JM Download Manager",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
