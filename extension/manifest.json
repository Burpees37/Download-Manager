{
  "manifest_version": 3,
  "name": "JM Download Manager",
  "version": "1.5.0",
  "description": "Sends downloads and videos to the JM Download Manager app for fast multi-connection downloading.",
  "key": "",
  "permissions": [
    "downloads",
    "contextMenus",
    "cookies",
    "storage",
    "webRequest",
    "nativeMessaging",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JM Download Manager",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jmdm@jmbuilds",
      "strict_min_version": "121.0"
    }
  }
}
